{
  "name": "ceibbo",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "setup": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "dev": "npm --prefix frontend run dev",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "test": "node scripts/test-services.mjs",
    "verify:unit2": "node scripts/verify-unit2.mjs",
    "doctor": "node scripts/check-env.mjs",
    "local:up": "docker compose up -d --wait && npm run local:init",
    "local:init": "node scripts/local/crear-tabla.mjs",
    "local:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}
